# Copy to torxng/.env (git-ignored) and fill in SEARXNG_SECRET.
#
# Generate a random value with one of:
#   Linux/macOS/Git Bash:  openssl rand -hex 32
#   PowerShell 7:          [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(32)).ToLower()
#   Python:                python -c "import secrets; print(secrets.token_hex(32))"

# server.secret_key of SearXNG (signs the image proxy URLs and other tokens).
# Required: SearXNG exits if it is left at the default "ultrasecretkey".
SEARXNG_SECRET=

# The password of the Tor ControlPort is NOT configured here: it is a file,
# torxng/secrets/tor_control_password, mounted into the tor container as the
# Compose secret /run/secrets/tor_control_password (so it is not visible in
# "docker inspect"). Create it with
#   openssl rand -hex 32 > secrets/tor_control_password
# (PowerShell: see README.md). Missing or empty file = ControlPort disabled.

# Port of the published HTTP endpoint. It is always bound to 127.0.0.1
# (local machine only); remote visitors use the onion address.
SEARXNG_PORT=8080

# Port of the clearnet baseline (compose profile "baseline", benchmark only).
SEARXNG_BASELINE_PORT=8081
